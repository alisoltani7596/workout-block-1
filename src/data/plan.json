    },
    "db_row_one": {
      "name": "One-Arm Dumbbell Row",
      "dbId": "One-Arm_Dumbbell_Row",
      "equipment": "dumbbell, bench",
      "cue": "Flat back, no twisting. Drive the elbow to the back pocket."
    },
